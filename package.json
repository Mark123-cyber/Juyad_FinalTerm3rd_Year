{
  "name": "slsu-lost-and-found",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.js",
    "dev:web": "vite",
    "start": "node scripts/ensure-env.js && node --env-file=.env server/index.js",
    "build": "vite build",
    "lint": "oxlint src server scripts",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
